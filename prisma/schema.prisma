generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Schedule {
  id             Int        @id @default(autoincrement())
  init           Boolean    @default(false)
  date           DateTime
  numRest        Int        @default(0)
  group          Int        @default(0)
  worker         Employee[] @relation("employeeSchedule")
  dayEmpCount    Int        @default(3)
  dayGroup       Int[]
  nightGroup     Int[]
  selectedDay    Int[]
  selectedNight  Int[]
  dayWorkCount   Int[]
  nightWorkCount Int[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  workCount Int      @default(0)
  isNew     Boolean  @default(false)
  plan      Int[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleId Int
  schedule   Schedule @relation("employeeSchedule", fields: [scheduleId], references: [id])
}
